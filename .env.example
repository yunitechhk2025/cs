OPENAI_API_KEY=你的真实key
OPENAI_MODEL=qwen3.6-flash
OPENAI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 客户在聊天里发图片时，用来把图片内容转成文字描述的视觉模型（描述会并进客户的提问一起
# 走正常的题库检索/回答流程，AI 不会脱离题库自由作答）。阿里百炼可选（价格为每百万 token）：
#   qwen3-vl-flash  输入0.15/输出1.5  专用视觉模型里最便宜，做"描述图片"够用（默认）
#   qwen3-vl-plus   输入1/输出10      视觉理解更强，图片细节/文字识别更准
#   qwen3.6-flash   输入1.2/输出7.2   就是上面 OPENAI_MODEL 在用的模型，本身支持图像，不想多配一个模型时用它
#   qwen3.7-plus    输入2/输出8       旗舰模型，效果最好、成本最高
# 留空或不配置则使用默认值；没有可用的视觉模型时图片仍能正常发送，只是没有文字描述。
VISION_MODEL=qwen3-vl-flash

FAQ_TOP_K=8
FAQ_MIN_SCORE=0.05
# 语义检索所用的 embedding 模型，用于识别措辞不同但意思相同的相似问题
FAQ_EMBED_MODEL=text-embedding-v3
# 脱敏版默认 8001，与同机正式版（通常 8000）错开
APP_PORT=8001

# ---- 三种工作模式 & 客服工作台 ----

# JWT 签名密钥（客服登录鉴权用，务必修改为随机字符串）
JWT_SECRET=change_this_to_a_random_secret_string

# 首次启动自动创建的管理员账号（请登录后立即修改密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# 系统首次启动时的默认模式：auto(全AI) / manual(全人工) / collab(人机协同)
DEFAULT_MODE=auto

# ---- WhatsApp 接入（可选，不配则只有网页端客服） ----
# 全部留空时 /api/whatsapp/webhook 会拒绝所有请求，其余功能完全不受影响。
# 前两项在 Meta 开发者后台 → 你的应用 → WhatsApp → API Setup 里拿：
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# 自己随便定一个字符串，在 Meta 后台配置 webhook 时填一模一样的值（用于握手校验）
WHATSAPP_VERIFY_TOKEN=
# Meta 后台 → 应用设置 → 基本 → 应用密钥。用来校验每个 webhook 请求的签名，
# 不配也能跑通流程（会打警告并跳过校验），但正式对外前一定要配上。
WHATSAPP_APP_SECRET=
# Graph API 版本，Meta 大约每季度发一版、旧版约两年后停用，需要升级时改这里
WHATSAPP_API_VERSION=v21.0

# ---- 邮件提醒（问题转人工时提醒客服/管理员） ----
# 未配置 SMTP_HOST 时会跳过发送并只打印警告日志，不影响其余功能。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=你的发信邮箱
SMTP_PASSWORD=你的发信密码或应用专用密码
SMTP_FROM=你的发信邮箱
# 是否使用 STARTTLS（大多数服务商用 587 端口时为 true）；如果用 465 端口的 SSL，改用 SMTP_USE_SSL=true
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# 收件邮箱，可用逗号分隔多个；测试阶段先发到测试邮箱。
# 也可以不改这里，登录客服工作台后在「工作台设置 → 邮件提醒收件人」里配置，后台配置的优先级更高。
NOTIFY_EMAIL_TO=yunitechhk@gmail.com
